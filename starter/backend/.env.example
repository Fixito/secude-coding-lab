NODE_ENV=development

PORT=5000
HOSTNAME=localhost

DB_FILE_NAME=file:local.db

# URL de l'API frontend pour les requêtes CORS. En développement, utiliser http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Clé secrète pour signer les tokens JWT. Doit faire au minimum 32 caractères.
# En production, utiliser une valeur aléatoire forte : openssl rand -hex 64
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_64

# Clé secrète pour signer les cookies de session. Doit faire au minimum 32 caractères.
# En production, utiliser une valeur aléatoire forte : openssl rand -hex 64
COOKIE_SECRET=dev_cookie_secret_key_do_not_use_in_production_at_all

